import("//build/test.gni")
import("//foundation/multimedia/player_framework/config.gni")

module_output_path = "player_framework/player_framework/avplayer"

ohos_unittest("avplayer_napi_test") {
  module_out_path = module_output_path

  include_dirs = [
    "./",
    "$MEDIA_PLAYER_ROOT_DIR/interfaces/inner_api",
    "$MEDIA_PLAYER_ROOT_DIR/interfaces/inner_api/native",
    "$MEDIA_PLAYER_ROOT_DIR/frameworks/js/avplayer",
    "$MEDIA_PLAYER_ROOT_DIR/frameworks/js/common",
    "$MEDIA_PLAYER_ROOT_DIR/frameworks/js/mediasource",
    "$MEDIA_PLAYER_ROOT_DIR/services/utils/include",
  ]

  cflags = [
    "-Wall",
    "-Werror",
    "-Dprivate=public",
    "-Dprotected=public",
  ]

  defines = []
  defines += player_framework_defines

  sanitize = {
    cfi = true
    cfi_cross_dso = true
  }

  sources = [
    "avplayer_napi_test.cpp",
    "$MEDIA_PLAYER_ROOT_DIR/frameworks/js/avplayer/avads_controller_napi.cpp",
    "$MEDIA_PLAYER_ROOT_DIR/frameworks/js/avplayer/avplayer_callback.cpp",
    "$MEDIA_PLAYER_ROOT_DIR/frameworks/js/avplayer/avplayer_napi.cpp",
    "$MEDIA_PLAYER_ROOT_DIR/frameworks/js/avplayer/media_data_source_callback.cpp",
    "$MEDIA_PLAYER_ROOT_DIR/frameworks/js/common/common_napi.cpp",
    "$MEDIA_PLAYER_ROOT_DIR/frameworks/js/common/js_common_utils.cpp",
    "$MEDIA_PLAYER_ROOT_DIR/frameworks/js/mediasource/media_source_loader_callback.cpp",
    "$MEDIA_PLAYER_ROOT_DIR/frameworks/js/mediasource/media_source_loading_request_napi.cpp",
    "$MEDIA_PLAYER_ROOT_DIR/frameworks/js/mediasource/media_source_napi.cpp",
  ]

  deps = [
    "$MEDIA_PLAYER_ROOT_DIR/interfaces/inner_api/native:media_client",
    "$MEDIA_PLAYER_ROOT_DIR/services/utils:media_service_utils",
  ]

  external_deps = [
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "audio_framework:audio_foundation",
    "av_codec:av_codec_client",
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "ets_runtime:libark_jsruntime",
    "eventhandler:libeventhandler",
    "googletest:gtest",
    "googletest:gmock",
    "graphic_surface:surface",
    "hilog:libhilog",
    "hisysevent:libhisysevent",
    "hitrace:hitrace_meter",
    "ipc:ipc_core",
    "libuv:uv",
    "media_foundation:media_foundation",
    "napi:ace_napi",
    "node:node_header_notice",
    "qos_manager:qos",
    "samgr:samgr_proxy",
  ]

  if (player_framework_support_jsstack) {
    external_deps += [ "hiview:libxpower_event_js" ]
  }

  if (player_framework_support_drm) {
    external_deps += [ "drm_framework:drm_framework" ]
  }

  resource_config_file =
      "$MEDIA_PLAYER_ROOT_DIR/test/unittest/resources/ohos_test.xml"
}
